{
  "manifest_version": 3,
  "name": "Laugh",
  "version": "0.1.0",
  "description": "Mark the exact moment a video made you laugh, and build a picture of your own sense of humour.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://www.googleapis.com/*"],
  "background": {
    "service_worker": "dist/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["dist/marker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Laugh",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "mark-laugh": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Mark this moment as funny"
    }
  }
}
